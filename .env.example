# Required: public base URL (email links, passkey RP ID)
APP_URL=http://localhost:3000
# Extra allowed origins, comma-separated (LAN use)
APP_ORIGINS=
PORT=3000
DATA_DIR=./data
BACKUP_DIR=./data/backups
SESSION_TTL_DAYS=14
SESSION_IDLE_HOURS=72
STORAGE_CAP_GB=8
MAX_UPLOAD_MB=100
ENABLE_DEMO_ACCOUNTS=1
DEMO_STORAGE_CAP_MB=200
DEMO_RESET_HOUR=3
SEED_SAMPLE_CONTENT=1
# Email is off when empty, e.g. smtps://user:pass@smtp.host:465
SMTP_URL=
MAIL_FROM=
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=
TRUST_PROXY=0
# cdn | local (run `npm run vendor` first)
ASSETS=cdn
LOG_LEVEL=info
# Breached-password check via Have I Been Pwned (k-anonymity)
HIBP_CHECK=1

# Optional built-in HTTPS (HTTP/2) when no reverse proxy terminates TLS; set both.
TLS_CERT_FILE=
TLS_KEY_FILE=
